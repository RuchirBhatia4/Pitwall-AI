# --- Backend (FastAPI, src/api/main.py) ---
PITWALL_STORAGE_BACKEND=csv
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGIN_REGEX=https://.*\.vercel\.app

# Live data via OpenF1 (live sessions need an OpenF1 sponsor account; finished sessions are free)
OPENF1_USERNAME=
OPENF1_PASSWORD=
# or a pre-issued token
OPENF1_TOKEN=

# "Ask the pit wall" chat: set to let an LLM answer via tool calls into the engine.
# Without it the chat still works in engine mode (rule-based, same numbers).
ANTHROPIC_API_KEY=
# Optional: override the chat model
PITWALL_CHAT_MODEL=

# --- Frontend (Next.js, frontend/) ---
# Where the Next.js server proxies /api/* to.
PITWALL_API_URL=http://127.0.0.1:8010
